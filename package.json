{
  "name": "musecode-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open source desktop home for Meta Muse Code.",
  "license": "MIT",
  "main": "electron/entry.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "npm run build && node --test tests/desktop.e2e.mjs",
    "check": "tsc --noEmit",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@muse-code/sdk": "1.4.6",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "@playwright/test": "^1.58.0"
  },
  "overrides": { "@electron/get": "5.1.0" },
  "build": {
    "appId": "community.musecode.desktop",
    "productName": "MuseCode",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.png", "LICENSE", "package.json"],
    "win": { "target": ["nsis"], "icon": "build/icon.ico", "signExecutable": false },
    "mac": { "target": ["dmg"], "category": "public.app-category.developer-tools" },
    "linux": { "target": ["AppImage"], "category": "Development" }
  }
}
